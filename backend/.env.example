# --- Application ---
APP_NAME="Cardiac Rehab Platform"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_ME_with_a_48_byte_random_string_see_command_above
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database ---
# Dev default is SQLite. For Postgres:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cardiac
DATABASE_URL=sqlite+aiosqlite:///./cardiac.db

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Retrieval ---
# auto tries fastembed, then sentence-transformers, then openai.
# Set to "none" to force lexical-only retrieval.
#
# Bengali queries against the English corpus need a multilingual encoder.
# Preferred (needs torch, matches the models used in our other work):
#   EMBEDDING_BACKEND=sentence-transformers
#   EMBEDDING_MODEL=BAAI/bge-m3
# Lighter alternative, ONNX with no torch, same dimension:
#   EMBEDDING_BACKEND=fastembed
#   EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_BACKEND=flagembedding
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# hybrid | dense | lexical
RETRIEVAL_MODE=hybrid

# Cross-encoder reranking. Costs ~100-300ms per query on CPU and is what makes
# a relevance threshold meaningful across languages. Calibrate MIN_RERANK_SCORE
# with `python -m scripts.retrieval_debug`.
RERANK_ENABLED=false
MIN_DENSE_SIMILARITY=0.50
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BACKEND=flagembedding
RERANK_CANDIDATES=20
MIN_RERANK_SCORE=0.30

# --- Scheduling ---
# The rota is authored in clinic-local wall-clock time; this is that clock's
# offset from UTC in minutes. 360 = UTC+6 (Bangladesh Standard Time).
CLINIC_TIMEZONE_OFFSET_MINUTES=360

# --- Online consultations ---
# jitsi needs no credentials, so booking produces a working link out of the box.
# zoom and google_meet need per-clinic OAuth; see app/services/meetings.py.
MEETING_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.jit.si

# --- Uploads ---
# Where profile photographs are written, relative to the backend directory.
MEDIA_ROOT=media
MAX_AVATAR_BYTES=4194304
AVATAR_EDGE_PX=512

# --- Speech / LLM (optional; voice Q&A is disabled without these) ---
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
CHAT_MODEL=gpt-4o-mini
# The clinician assistant reasons over a whole record rather than three
# passages, so it gets the larger model.
CLINICIAN_ASSISTANT_MODEL=gpt-4o
