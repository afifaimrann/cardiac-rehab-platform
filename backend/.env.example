# --- Application ---
APP_NAME="Cardiac Rehab Platform"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_ME_with_a_48_byte_random_string_see_command_above
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database ---
# Dev default is SQLite. For Postgres:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cardiac
DATABASE_URL=sqlite+aiosqlite:///./cardiac.db

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Speech / LLM (optional; voice Q&A is disabled without these) ---
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
CHAT_MODEL=gpt-4o-mini
